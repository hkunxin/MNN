<?xml version="1.0" encoding="utf-8"?>
<!-- V2.1 Tab1 对话 · 对齐 ui-design.html 屏1：appbar + 会话列表 + FAB(＋) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- appbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="对话"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1B1F27" />

            <TextView
                android:id="@+id/btnMeetingEntry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="🎙 会议记录"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3C4457" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/chatListContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- FAB ＋（设计稿：点击展开 新建对话 / 开始会议） -->
    <TextView
        android:id="@+id/fabNew"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_fab"
        android:gravity="center"
        android:text="＋"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:elevation="6dp" />
</FrameLayout>
