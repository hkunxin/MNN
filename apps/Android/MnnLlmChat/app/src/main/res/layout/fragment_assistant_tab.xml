<?xml version="1.0" encoding="utf-8"?>
<!-- V2.1 Tab2 助理 · 对齐 ui-design.html 屏3：appbar + 状态 chips + 分类摘要卡片 + 入口卡 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EEF1F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- appbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="通知助理"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1B1F27" />

            <TextView
                android:id="@+id/btnAssistantSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⚙"
                android:textSize="17sp"
                android:textColor="#6B7280"
                android:background="@drawable/bg_chip" />
        </LinearLayout>

        <!-- 状态 chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chipLastSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="上次总结 —"
                android:textSize="11sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/chipQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_blue"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="待判队列 0 条"
                android:textSize="11sp"
                android:textColor="#1A73E8"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="息屏 0 推理"
                android:textSize="11sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <!-- 摘要分类卡片容器（AssistantTabFragment 动态填充分类卡） -->
        <LinearLayout
            android:id="@+id/summaryCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- 空摘要占位 -->
        <LinearLayout
            android:id="@+id/summaryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_white"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="尚无通知摘要"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B1F27" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="亮屏进入摘要页点「生成摘要」，批量识别后的通知将分类罗列在此"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- 屏蔽与规则入口卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white">

            <LinearLayout
                android:id="@+id/btnRuleSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="屏蔽规则建议"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B1F27" />

                <TextView
                    android:id="@+id/badgeRulePending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FDF3DC"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="2 条待确认"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#B06000"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textSize="15sp"
                    android:textColor="#C3C9D6" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginStart="14dp"
                android:background="#F0F2F7" />

            <LinearLayout
                android:id="@+id/btnBlockLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="拦截与学习动态"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B1F27" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="15sp"
                    android:textColor="#C3C9D6" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginStart="14dp"
                android:background="#F0F2F7" />

            <LinearLayout
                android:id="@+id/btnNotifyAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/notifyAccessLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="通知使用权：检测中…"
                    android:textSize="14sp"
                    android:textColor="#1B1F27" />

                <TextView
                    android:id="@+id/badgeNotifyAccess"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#E6F4EA"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="已连接"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#188038" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnOpenDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:text="Debug 面板 ›"
            android:textColor="#9AA3B2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
