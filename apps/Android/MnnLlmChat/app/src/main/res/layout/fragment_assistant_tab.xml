<?xml version="1.0" encoding="utf-8"?>
<!-- V2.1 Tab2 助理：通知摘要 + 规则建议 + 拦截动态 + 助理设置（判定模型/阈值/仅亮屏锁定项） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="助理"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 通知摘要 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:text="通知摘要"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#666666" />

        <LinearLayout
            android:id="@+id/cardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#14000000">

            <TextView
                android:id="@+id/assistantSummaryPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:ellipsize="end"
                android:textSize="13sp"
                android:text="（尚无摘要，进入后点「生成摘要」）" />

            <TextView
                android:id="@+id/btnOpenSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingTop="8dp"
                android:text="打开摘要页 ›"
                android:textColor="#1E88E5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 功能入口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:text="屏蔽与规则"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="#14000000">

            <TextView
                android:id="@+id/btnRuleSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="规则建议"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#22000000" />

            <TextView
                android:id="@+id/btnBlockLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="拦截动态"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#22000000" />

            <TextView
                android:id="@+id/btnNotifyAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="通知使用权：检测中…"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 助理设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:text="助理设置"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="#14000000">

            <LinearLayout
                android:id="@+id/rowJudgeModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="判定 / 摘要 / 纪要模型"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/judgeModelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="180dp"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:text="未设置" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#22000000" />

            <LinearLayout
                android:id="@+id/rowAutoThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="高置信自动屏蔽阈值"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/autoThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:text="0.90" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="#22000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="仅亮屏处理（省电策略）"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已锁定"
                    android:textSize="12sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnOpenDebug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:padding="12dp"
            android:text="Debug 面板 ›"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
