<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/notifyAccessButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开通知使用权设置" />

    <Button
        android:id="@+id/notifyRefreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="刷新链路状态" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notifyClearQueueButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="清空待判队列" />

        <Button
            android:id="@+id/notifyClearDigestButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="清空摘要库" />
    </LinearLayout>

    <Button
        android:id="@+id/notifyRunBatchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="手动触发批处理(强制,验证门控)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/notifyJudgeModelEdit"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="判定模型 modelId(如 taobao-mnn/Qwen2.5-1.5B-Instruct)"
            android:inputType="text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/notifyJudgeModelSetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/notifyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:text="status: -" />
    </ScrollView>
</LinearLayout>
